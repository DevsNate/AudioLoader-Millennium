{
  "type": "module",
  "name": "audioloader-millennium",
  "version": "1.0",
  "description": "Replaces Steam's UI sounds and adds menu music with packs from DeckThemes, in Big Picture and on the Steam desktop.",
  "author": "DevsNate",
  "license": "GPL-3.0-or-later",
  "upstream": {
    "repository": "https://github.com/DeckThemes/SDH-AudioLoader",
    "version": "1.6.1",
    "commit": "9b4b5869f8878ac08f8fbbf8cd1a4c96cb1a863e"
  },
  "scripts": {
    "dev": "starlight watch",
    "build": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && starlight pack --release && node scripts/checks/starlight-bundle.mjs",
    "vendor": "node scripts/vendor.mjs",
    "check": "node scripts/run-checks.mjs",
    "sync-upstream": "node scripts/sync-upstream.mjs"
  },
  "devDependencies": {
    "@steambrew/starlight": "^1.1.7",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "fengari": "0.1.5",
    "react-fast-compare": "^3.2.2",
    "react-icons": "4.12.0",
    "typescript": "^5.9.3"
  }
}
